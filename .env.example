# --- Generation ---------------------------------------------------------
# Which provider writes the answers. "anthropic" (default) or "openai".
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Optional per-role model overrides. Defaults live in src/lib/clients.ts:
# `answer` writes the guest reply, `utility` does the cheap query rewrite in
# the contextualize node.
# ANSWER_MODEL=claude-haiku-4-5-20251001
# UTILITY_MODEL=claude-haiku-4-5-20251001

# --- Embeddings ---------------------------------------------------------
# ALWAYS required, on both providers: Anthropic publishes no embeddings
# endpoint, so retrieval (text-embedding-3-small) stays on OpenAI. This is
# also the generation key when LLM_PROVIDER=openai.
OPENAI_API_KEY=sk-proj-replace-me

# --- Database -----------------------------------------------------------
# Postgres with the pgvector extension.
# Matches the credentials in docker-compose.yml.
#
# If you already run Postgres natively, it will own port 5432 and silently
# shadow the container's port mapping (you'll see "password authentication
# failed"). In that case publish the container on a free port instead, and
# make sure this URL uses the same one:
#   POSTGRES_HOST_PORT=5433
#
# From your host (npm run dev / npm run seed):
DATABASE_URL=postgresql://askmystay:askmystay@localhost:5432/askmystay
# From inside the app container, the host is the service name instead:
# DATABASE_URL=postgresql://askmystay:askmystay@postgres:5432/askmystay

# Optional: which property the seed script loads the guidebook under.
# SEED_PROPERTY_ID=sunset-ridge-cabin

# --- Content source (Strapi) --------------------------------------------
# The guidebook can come from src/data/guidebook.md (default) or from Strapi:
#   npm run seed                     # markdown
#   npm run seed -- --source=strapi  # CMS
#
# From the host:
STRAPI_URL=http://localhost:1337
# From inside the compose network the host is the service name instead:
# STRAPI_URL=http://strapi:1337
#
# Only needed if you lock the Guidebook Section content type down. The Strapi
# bootstrap grants the Public role read access, so this is normally blank.
# STRAPI_API_TOKEN=

# Shared secret for POST /api/reindex, the webhook Strapi calls on every content
# change. The endpoint refuses to run when this is unset — it spends money and
# rewrites what the assistant is allowed to say.
REINDEX_SECRET=dev-reindex-secret-change-me

# Strapi's own secrets. docker-compose.yml falls back to dev values so a clean
# checkout boots; generate real ones before exposing the CMS anywhere:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# STRAPI_APP_KEYS=key1,key2,key3,key4
# STRAPI_API_TOKEN_SALT=
# STRAPI_ADMIN_JWT_SECRET=
# STRAPI_TRANSFER_TOKEN_SALT=
# STRAPI_JWT_SECRET=
# STRAPI_ENCRYPTION_KEY=

# --- Embeddable widget --------------------------------------------------
# Which sites may frame /embed/<property> — a CSP frame-ancestors allowlist.
# Defaults to 'self', which is enough for the bundled demo at
# /demo-property-page.html. Add partner origins explicitly, space separated:
#   EMBED_ORIGINS=https://guidebook.example.com https://*.example.com
# EMBED_ORIGINS=
