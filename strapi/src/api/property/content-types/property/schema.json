{
  "kind": "collectionType",
  "collectionName": "properties",
  "info": {
    "singularName": "property",
    "pluralName": "properties",
    "displayName": "Property",
    "description": "A short-term rental listing. `slug` is the property_id the assistant scopes retrieval by."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "sections": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::guidebook-section.guidebook-section",
      "mappedBy": "property"
    }
  }
}
