{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler"
	},
	// Overriding `include` means replicating the paths SvelteKit generates in
	// .svelte-kit/tsconfig.json (rewritten relative to this file), or `$env/*`
	// and `./$types` lose their types. The addition is `scripts/`, which the
	// generated config does not cover.
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/env.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"scripts/**/*.ts"
	],
	"exclude": ["node_modules/**", "build/**"]
}
